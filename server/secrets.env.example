# Worker secrets for `cf deploy --secrets-file secrets.env`. Copy to secrets.env (gitignored) and fill in.
# 32 random bytes as 64 hex chars: openssl rand -hex 32
BAO_SEAL_KEY=
# Neon Postgres connection URL: direct host (no -pooler), ?sslmode=verify-full, no channel_binding
# e.g. postgresql://<user>:<password>@ep-xxxx.<region>.aws.neon.tech/neondb?sslmode=verify-full
NEON_DATABASE_URL=
# Access team domain as a full URL, no trailing slash (https://<team>.cloudflareaccess.com)
ACCESS_TEAM_DOMAIN=
# Audience (AUD) tag of the Access application
ACCESS_AUD=
# Owner's email address, the only identity allowed through
OWNER_EMAIL=
